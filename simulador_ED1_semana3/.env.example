# Desarrollo local: copiar a .env y cargar variables con las instrucciones README
ENVIRONMENT=development
# Si no configuras DATABASE_URL se usa SQLite SOLO en localhost.
# DATABASE_URL=postgresql://usuario:password@host:5432/nombre?sslmode=require
# Fija AUTH_SECRET en Vercel (min 32 caracteres aleatorios) y también en localhost.
AUTH_SECRET=cambia-esta-clave-por-un-valor-aleatorio-de-32-caracteres-o-mas
# Solo LOCAL: imprimir codigo en terminal, NO enviar correo real
EMAIL_BACKEND=console
# Produccion recomendada: Resend API (dominio verificado)
# EMAIL_BACKEND=resend
# RESEND_API_KEY=re_XXXXXXXXXXXXXXXX
# MAIL_FROM=ED1 <acceso@tudominio.com>
# Opcion Gmail SMTP con contraseña de aplicación (solo local, no recomendada en Vercel):
# EMAIL_BACKEND=gmail_smtp
# GMAIL_USER=tu_cuenta@gmail.com
# GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx
# ADMIN_BOOTSTRAP_ORG=Mi Empresa
# ADMIN_BOOTSTRAP_EMAIL=admin@miempresa.com
# ADMIN_BOOTSTRAP_PASSWORD=una-clave-de-al-menos-12-caracteres
